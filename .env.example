# Copy this file to .env and fill in the values for local development.
# For Docker-based setup, use .env.docker.example instead.

# ── Backend ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB (local)
MONGODB_URI=mongodb://127.0.0.1:27017/smartlearn

# JWT — use a long random string in production
JWT_SECRET=change-me-strong-secret

# MySQL (local)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smartlearn
MYSQL_USER=root
MYSQL_PASSWORD=root

# ML Service (optional — fallback scoring used if not set)
ML_SERVICE_URL=http://localhost:8001

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000
